# 环境说明
# local: 默认本地环境，IDE 直接启动即可，使用 MySQL。
# dev: 共享开发环境，使用 MySQL/Redis 等外部服务。
# prod: 生产环境，必须显式配置所有凭据。
#
# 复制此文件为 .env 并填入真实值，.env 文件不会被提交到代码库。

SPRING_PROFILES_ACTIVE=dev

# ===== 数据库 =====
DB_URL=jdbc:mysql://localhost:3306/data_agent?useUnicode=true&characterEncoding=utf8&useSSL=false&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true
DB_USERNAME=your_db_username
DB_PASSWORD=your_db_password

# ===== Redis（必须）=====
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ===== 模型 API =====
# 本地默认模型配置。Moonshot 开放平台 Key 使用下面这种：
# LANGCHAIN_API_KEY=your_moonshot_api_key
# LANGCHAIN_BASE_URL=https://api.moonshot.cn/v1
# LANGCHAIN_MODEL_NAME=kimi-k2.6
# Kimi Code / Kimi Coding Key 使用下面这种：
# LANGCHAIN_API_KEY=your_kimi_code_api_key
# LANGCHAIN_BASE_URL=https://api.kimi.com/coding/v1
# LANGCHAIN_MODEL_NAME=kimi-for-coding
LANGCHAIN_API_KEY=your_llm_api_key
LANGCHAIN_BASE_URL=https://api.openai.com/v1
LANGCHAIN_MODEL_NAME=gpt-4

# ===== Milvus 向量库（必须）=====
MILVUS_HOST=localhost
MILVUS_PORT=19530

# ===== Embedding 模型 =====
# provider: local（本地 AllMiniLmL6V2，384 维）| api（OpenAI 兼容端点，支持 BGE-zh 等中文模型）
EMBEDDING_PROVIDER=local
EMBEDDING_DIMENSION=384
# 模型、维度或归一化策略变化时必须提升版本，并对新 Collection 重建索引。
EMBEDDING_INDEX_VERSION=v1
EMBEDDING_NORMALIZE=true
EMBEDDING_METRIC=COSINE
# API 模式下的配置（provider=api 时生效）
EMBEDDING_API_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL_NAME=bge-large-zh-v1.5
# API 模型维度必须按服务实际输出显式设置；例如该模型常见为 1024，不能沿用本地默认 384。

# ===== RAG 全文检索（Elasticsearch BM25，必需）=====
RAG_ELASTICSEARCH_BASE_URL=http://localhost:9200
RAG_ELASTICSEARCH_INDEX=data-agent-rag-v2
RAG_ELASTICSEARCH_USERNAME=
RAG_ELASTICSEARCH_PASSWORD=
RAG_ELASTICSEARCH_CONNECT_TIMEOUT=2s
RAG_ELASTICSEARCH_REQUEST_TIMEOUT=5s

# ===== RAG 黄金集批量评测 =====
# 指向人工标注的真实JSON文件；不会从仓库内置伪造标注。仅管理员可触发运行。
RAG_BENCHMARK_DATASET_PATH=./config/rag-golden-dataset.json
RAG_BENCHMARK_MINIMUM_CASES=30
RAG_BENCHMARK_MAXIMUM_CASES=200

# ===== 安全 =====
# JWT Secret 建议用 openssl rand -base64 64 生成
JWT_SECRET=your_random_256bit_jwt_secret_at_least_32_chars

# 数据库字段加密密钥，建议用 openssl rand -base64 32 生成
APP_ENCRYPTION_KEY=your_random_encryption_key_at_least_32_chars

# ===== CORS =====
APP_CORS_ORIGINS=https://your-frontend-domain.com

# ===== 限流 =====
RATE_LIMIT_RPM=20

# ===== Token 配额 =====
# 每用户每日最大 Token 用量（默认 100 万）
TOKEN_QUOTA_DAILY=1000000
